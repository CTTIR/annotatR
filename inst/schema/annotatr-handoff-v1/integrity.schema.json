{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "annotatr-handoff-v1/integrity.schema.json",
  "title": "Handoff content inventory",
  "description": "Every regular file of a handoff directory except integrity.json itself, sorted by UTF-8 path. The handoff digest is SHA-256 over the canonical JSON of this document (sorted keys, no whitespace, integer sizes, no trailing newline), identical to the qupflowR bundle_digest rule.",
  "type": "object",
  "required": ["format_version", "files"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024,
                   "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|/)\\.\\.?(/|$))[^\\\\]+$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
